{
  "manifest_version": 3,
  "name": "Pi Control Chrome",
  "version": "0.5.1.1",
  "version_name": "0.5.1-p3-live",
  "description": "Local Chrome/Edge bridge for Pi browser control.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "tabGroups",
    "debugger",
    "downloads",
    "clipboardRead",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:17318 ws://127.0.0.1:17318"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pi Control Chrome"
  }
}
