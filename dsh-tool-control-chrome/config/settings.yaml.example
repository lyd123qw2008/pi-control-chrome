# Copy this section to <DSH_HOME>/settings.yaml.
# Keep the pairing token in the referenced file; never paste the token here.
control-chrome:
  # The checked-in extension connects to 127.0.0.1:17318; custom values require a matching extension build and CSP.
  bridgeHost: 127.0.0.1
  bridgePort: 17318
  tokenFile: C:/Users/<user>/.pi/agent/pi-control-chrome.token
  autoStartBridge: true
  requestTimeoutMs: 120000
  # Wait for the extension's background reconnect before returning bridge_only.
  extensionReadyTimeoutMs: 6000
  # Register browser_* tools only after the pi-control-chrome Skill loads in the legacy lazy-full mode.
  lazyTools: true
  # progressive registers a fixed facade from startup and discovers operations through tool results without changing tools.
  # exposureMode: progressive
  # Set lazyTools: false temporarily for legacy eager raw-tool visibility.
