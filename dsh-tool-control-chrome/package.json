{
  "name": "@lyd123qw2008/dsh-tool-control-chrome",
  "version": "0.5.3",
  "description": "DeepSeek Harness browser-control tools backed by the pi-control-chrome local Bridge",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "browser-control",
    "chrome",
    "edge",
    "pi-control-chrome"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyd123qw2008/pi-control-chrome.git",
    "directory": "dsh-tool-control-chrome"
  },
  "homepage": "https://github.com/lyd123qw2008/pi-control-chrome/tree/main/dsh-tool-control-chrome",
  "bugs": {
    "url": "https://github.com/lyd123qw2008/pi-control-chrome/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "files": [
    "config/cordis.patch.yml.example",
    "config/settings.yaml.example",
    "lib/bridge.js",
    "lib/commands.js",
    "lib/diagnostics.js",
    "lib/index.js",
    "lib/invariant.js",
    "lib/output.js",
    "lib/skill.js",
    "lib/tools.js",
    "lib/types/**/*.d.ts",
    "skills/pi-control-chrome/SKILL.md",
    "skills/pi-control-chrome/references/recovery.md",
    "skills/pi-control-chrome/references/workflows.md",
    "README.md",
    "package.json"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "pi-control-chrome": "^0.5.3",
    "ws": "^8.18.0",
    "yaml": "2.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "corepack pnpm run check && corepack pnpm test && corepack pnpm run build",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@types/node": "^22.20.0",
    "@types/ws": "8.18.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
